<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.HJP" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!--
      The window preview is the launch screen on Android 7-11. MainActivity switches to Theme.HJP
      before creating the UI, so this drawable is visible only while Android is starting the app;
      it adds no artificial delay to model or UI startup.
    -->
    <style name="Theme.HJP.Starting" parent="Theme.HJP">
        <item name="android:windowBackground">@drawable/hjp_launch_screen</item>
    </style>
</resources>
