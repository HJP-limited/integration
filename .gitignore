*.iml
.gradle
/local.properties
/.idea/
.DS_Store
/build
# 모든 모듈의 빌드 산출물. 예전에는 /build 하나뿐이라 Agent_0910 모듈들이 들어오자
# build/ 가 통째로 스테이징됐다(테스트 클래스 파일명이 Windows 경로 한계를 넘어 add 가 죽었다).
build/
/captures
.externalNativeBuild
.cxx
local.properties

# Claude Code 개인 설정
.claude/settings.local.json

# Model and tokenizer artifacts (do not commit large/HF files)
*.safetensors
*.tflite
*.task
*.onnx
# OCR 검출·인식·토크나이저·방향분류는 합쳐 24MB 라 저장소에 둔다 — 이게 빠지면 클론만으로는
# 명함 인식이 아예 안 돈다. 분류기(kie_minilm_int8.onnx, 36.6MB)만 app/.gitignore 로 제외.
!app/src/main/assets/ocr/det.onnx
!app/src/main/assets/ocr/rec.onnx
!app/src/main/assets/ocr/kie_tokenizer.onnx
!app/src/main/assets/ocr/textline_ori.onnx
models/
# Kotlin installation code is not a model artifact.
!app/src/main/java/com/example/hjp/models/
app/src/main/assets/models/*
!app/src/main/assets/models/.gitkeep
app/src/main/assets/tokenizer/*
!app/src/main/assets/tokenizer/.gitkeep
*.tokenizer
/tokenizer.json
/tokenizer.model
/tokenizer_config.json
tokenizer.json
tokenizer.model
tokenizer_config.json
.kotlin/

# Python 캐시
__pycache__/
*.pyc

# Desktop real-model test runner sources are tracked; build/ and model artifacts remain excluded.

# Session handoffs and continuation prompts stay local.
/docs/새세션_인수인계_*.md
/docs/새세션_첫프롬프트_*.md
